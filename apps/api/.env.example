# apps/api — copy ke .env, isi dari Koyeb Secrets / Supabase (new keys)
DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
SUPABASE_SECRET_KEY=[secret-key] # sb_secret_... (legacy: SUPABASE_SERVICE_ROLE_KEY, server only, bypasses RLS)
# SUPABASE_PUBLISHABLE_KEY=[publishable-key] # sb_publishable_... jika API butuh client Supabase (opsional, RLS)
JWT_SECRET=[openssl rand -hex 32]
REFRESH_SECRET=[openssl rand -hex 32]
TEST_SECRET=[random-32-for-qa-only]
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
RESEND_API_KEY=re_...
OPENAI_API_KEY=sk-...
PORT=8080
APP_ENV=production
