# FlowBook — Env Template (PUBLIC REPO — jangan isi nilai real di sini)
# Copy ke .env.local / .env dan isi dari dashboard. Jangan commit .env !
# Lihat docs/DEPLOYMENT.md untuk cara ambil dari Vercel/Koyeb/Supabase.

# ── Supabase (pooler 6543 transaction) ──────────────────────────────
# Ambil dari Supabase Dashboard → Settings → Database → Connection string (pooler)
DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Untuk Next.js web jika pakai Supabase Storage direct (optional) — new keys (publishable sb_publishable_..., secret sb_secret_...)
NEXT_PUBLIC_SUPABASE_URL=https://[ref].supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=[publishable-key] # sb_publishable_... (legacy: NEXT_PUBLIC_SUPABASE_ANON_KEY)
SUPABASE_SECRET_KEY=[secret-key] # sb_secret_... (legacy: SUPABASE_SERVICE_ROLE_KEY, bypasses RLS — server only, never NEXT_PUBLIC)

# ── Next.js Web (Vercel) ────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://flowbook-api-xxx.koyeb.app/api/v1
# NEXT_PUBLIC_API_URL=http://localhost:8080/api/v1  # lokal

# ── Go API (Koyeb Secrets) ──────────────────────────────────────────
JWT_SECRET=[openssl rand -hex 32]
REFRESH_SECRET=[openssl rand -hex 32]
# TEST_SECRET hanya untuk QA/E2E helper POST /test/reset — jangan set di prod
TEST_SECRET=[random-32-char-for-qa-only]

# ── Stripe (Test Mode) ──────────────────────────────────────────────
# Dashboard → Developers → API keys (test)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ── Email ───────────────────────────────────────────────────────────
RESEND_API_KEY=re_...

# ── AI ──────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── App ─────────────────────────────────────────────────────────────
PORT=8080
APP_ENV=production
# APP_ENV=test  # hanya untuk Koyeb QA / lokal test
